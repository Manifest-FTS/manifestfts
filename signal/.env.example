# Public origin used for canonical URLs, emails, and OAuth/Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string. When unset, Signal uses an embedded PGlite database in ./.data (development only).
DATABASE_URL=

# 32+ random bytes used to sign share links and cron requests. Generate: openssl rand -base64 32
AUTH_SECRET=
CRON_SECRET=

# Email (Mailjet). When unset, emails are written to the server log instead of sent.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=noreply@manifestfts.com
MAILJET_FROM_NAME="Manifest Signal"

# Stripe billing. When unset, billing pages show plans but checkout is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# Live answer-engine adapters. Each engine collects live observations only when its key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Model for content-studio drafts (defaults to claude-opus-5-5). Drafting is enabled when ANTHROPIC_API_KEY is set.
ANTHROPIC_DRAFT_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Privacy-friendly analytics (optional).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
